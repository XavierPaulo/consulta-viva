# Desenvolvimento: SQLite local. Produção: troque o provider em prisma/schema.prisma para "postgresql"
# e use DATABASE_URL="postgresql://usuario:senha@host:5432/consultaviva"
DATABASE_URL="file:./dev.db"

# Endereço público do sistema (usado nos links enviados por WhatsApp/SMS/e-mail)
APP_URL="http://localhost:3000"

# ---- Lembretes automáticos ----
# Intervalo da verificação automática, em minutos (0 desliga; use com cron externo em /api/cron/lembretes)
REMINDERS_INTERVAL_MINUTES=5
# Senha do cron externo: GET /api/cron/lembretes com "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# ---- Provedores de mensagens (sem eles, os envios ficam simulados e registrados em Comunicação) ----
# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Modelo aprovado pela Meta com um parâmetro {{1}} no corpo (obrigatório para lembretes fora da janela de 24 h)
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="pt_BR"
# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# E-mail (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Clínica <nao-responda@suaclinica.com.br>"
