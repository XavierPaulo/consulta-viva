// ConsultaViva — modelo de dados do MVP (fase 1)
// Em desenvolvimento usamos SQLite; para produção troque o provider para "postgresql".
// Enums são guardados como String (compatível com SQLite); os valores válidos estão em src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Clinic {
  id                 String   @id @default("clinic")
  name               String
  tagline            String   @default("")
  about              String   @default("")
  cnpj               String   @default("")
  phone              String   @default("")
  whatsapp           String   @default("")
  email              String   @default("")
  address            String   @default("")
  logoUrl            String   @default("")
  heroImageUrl       String   @default("")
  primaryColor       String   @default("#0f766e")
  openingHours       String   @default("") // texto livre exibido na página, ex: "Seg a Sex, 8h às 18h"
  paymentMethods     String   @default("[]") // JSON: lista de chaves de PAYMENT_METHODS
  maxInstallments    Int      @default(1)
  instagram          String   @default("")
  facebook           String   @default("")
  linkedin           String   @default("")
  youtube            String   @default("")
  privacyPolicy      String   @default("")
  termsOfUse         String   @default("")
  cancellationPolicy String   @default("")
  hiddenSections     String   @default("[]") // JSON: seções opcionais marcadas como "ocultar"
  minBookingHours    Int      @default(2) // antecedência mínima para agendar online
  cancelMinHours     Int      @default(24) // antecedência mínima para cancelar/reagendar online
  bookingWindowDays  Int      @default(60)
  updatedAt          DateTime @updatedAt
}

model Unit {
  id            String         @id @default(cuid())
  name          String
  address       String         @default("")
  active        Boolean        @default(true)
  professionals Professional[]
  availability  Availability[]
  appointments  Appointment[]
}

model Specialty {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  description   String         @default("")
  symptoms      String         @default("") // palavras-chave para a busca por sintoma, separadas por vírgula
  icon          String         @default("stethoscope")
  active        Boolean        @default(true)
  professionals Professional[]
}

model Insurance {
  id            String         @id @default(cuid())
  name          String         @unique
  active        Boolean        @default(true)
  priceCents    Int?           // valor de repasse/tabela padrão (opcional)
  professionals Professional[]
  appointments  Appointment[]
}

model Professional {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  title         String          @default("Dr(a).")
  crm           String
  crmUf         String          @default("SP")
  photoUrl      String          @default("")
  gallery       String          @default("[]") // JSON: URLs de fotos adicionais
  bio           String          @default("")
  education     String          @default("")
  experience    String          @default("")
  priceCents    Int             @default(0)
  durationMin   Int             @default(30)
  inPerson      Boolean         @default(true)
  telemedicine  Boolean         @default(false)
  published     Boolean         @default(true)
  unitId        String?
  unit          Unit?           @relation(fields: [unitId], references: [id])
  specialties   Specialty[]
  insurances    Insurance[]
  availability  Availability[]
  appointments  Appointment[]
  records       MedicalRecord[]
  messages      Message[]
  user          User?
  createdAt     DateTime        @default(now())
}

model Availability {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int          // 0 = domingo ... 6 = sábado
  startTime      String       // "08:00"
  endTime        String       // "12:00"
  unitId         String?
  unit           Unit?        @relation(fields: [unitId], references: [id])
}

model Patient {
  id             String          @id @default(cuid())
  name           String
  cpf            String?         @unique // somente dígitos
  phone          String
  email          String          @default("")
  birthDate      DateTime?
  sex            String          @default("")
  address        String          @default("")
  notes          String          @default("")
  lgpdConsentAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  records        MedicalRecord[]
  payments       Payment[]
}

model Appointment {
  id             String          @id @default(cuid())
  professionalId String
  professional   Professional    @relation(fields: [professionalId], references: [id])
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  unitId         String?
  unit           Unit?           @relation(fields: [unitId], references: [id])
  start          DateTime
  end            DateTime
  type           String          @default("PRESENCIAL") // PRESENCIAL | TELECONSULTA
  status         String          @default("AGENDADA") // AGENDADA | CONFIRMADA | REALIZADA | CANCELADA | FALTOU
  insuranceId    String?
  insurance      Insurance?      @relation(fields: [insuranceId], references: [id])
  priceCents     Int             @default(0)
  source         String          @default("INTERNO") // ONLINE | INTERNO
  notes          String          @default("")
  cancelReason   String          @default("")
  manageToken    String          @unique @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  records        MedicalRecord[]
  payments       Payment[]

  @@index([professionalId, start])
  @@index([start])
}

model MedicalRecord {
  id             String             @id @default(cuid())
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  professionalId String
  professional   Professional       @relation(fields: [professionalId], references: [id])
  appointmentId  String?
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id])
  subjective     String             @default("")
  objective      String             @default("")
  assessment     String             @default("")
  plan           String             @default("")
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  prescriptions  PrescriptionItem[]

  @@index([patientId, createdAt])
}

model PrescriptionItem {
  id           String        @id @default(cuid())
  recordId     String
  record       MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  medication   String
  dosage       String        @default("")
  instructions String        @default("")
}

model Payment {
  id             String       @id @default(cuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  description    String       @default("")
  amountCents    Int
  method         String       // PIX | CREDITO | DEBITO | DINHEIRO | BOLETO | CONVENIO | LINK
  installments   Int          @default(1)
  status         String       @default("PENDENTE") // PENDENTE | PAGO | ESTORNADO | CANCELADO
  paidAt         DateTime?
  dueDate        DateTime?
  linkToken      String?      @unique
  gateway        String       @default("manual")
  gatewayRef     String       @default("")
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Message {
  id               String        @id @default(cuid())
  name             String
  email            String        @default("")
  whatsapp         String        @default("")
  preferredChannel String        @default("EMAIL") // EMAIL | WHATSAPP
  body             String
  professionalId   String?
  professional     Professional? @relation(fields: [professionalId], references: [id])
  status           String        @default("NOVA") // NOVA | LIDA | RESPONDIDA | ARQUIVADA
  reply            String        @default("")
  repliedAt        DateTime?
  repliedById      String?
  createdAt        DateTime      @default(now())
}

model Testimonial {
  id         String   @id @default(cuid())
  author     String
  text       String
  rating     Int      @default(5)
  authorized Boolean  @default(false) // só aparece na página com autorização do paciente
  createdAt  DateTime @default(now())
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

// Fila de mensagens (e-mail/SMS/WhatsApp). No MVP o envio é simulado e fica registrado aqui.
model Notification {
  id        String   @id @default(cuid())
  channel   String   // EMAIL | SMS | WHATSAPP
  to        String
  subject   String   @default("")
  body      String
  status    String   @default("SIMULADO") // SIMULADO | ENVIADO | FALHOU
  related   String   @default("")
  createdAt DateTime @default(now())
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String
  passwordHash        String
  role                String          // ADMIN | MEDICO | SECRETARIA | LEITURA
  active              Boolean         @default(true)
  failedAttempts      Int             @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  professionalId      String?         @unique
  professional        Professional?   @relation(fields: [professionalId], references: [id])
  permissionOverrides String          @default("{}") // JSON: { "modulo": ["acao", ...] } para permissões extras/granulares
  createdAt           DateTime        @default(now())
  sessions            Session[]
  resetTokens         PasswordReset[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("")
  action    String   // VIEW | CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAIL | LOGOUT | ...
  entity    String
  entityId  String   @default("")
  details   String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
