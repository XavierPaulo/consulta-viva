// ConsultaViva — modelo de dados (fases 1 e 2)
// Em desenvolvimento usamos SQLite; para produção troque o provider para "postgresql".
// Enums são guardados como String (compatível com SQLite); os valores válidos estão em src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Clinic {
  id                 String   @id @default("clinic")
  name               String
  tagline            String   @default("")
  about              String   @default("")
  cnpj               String   @default("")
  phone              String   @default("")
  whatsapp           String   @default("")
  email              String   @default("")
  address            String   @default("")
  logoUrl            String   @default("")
  heroImageUrl       String   @default("")
  primaryColor       String   @default("#0f766e")
  openingHours       String   @default("") // texto livre exibido na página, ex: "Seg a Sex, 8h às 18h"
  paymentMethods     String   @default("[]") // JSON: lista de chaves de PAYMENT_METHODS
  maxInstallments    Int      @default(1)
  instagram          String   @default("")
  facebook           String   @default("")
  linkedin           String   @default("")
  youtube            String   @default("")
  privacyPolicy      String   @default("")
  termsOfUse         String   @default("")
  cancellationPolicy String   @default("")
  hiddenSections     String   @default("[]") // JSON: seções opcionais marcadas como "ocultar"
  minBookingHours    Int      @default(2) // antecedência mínima para agendar online
  cancelMinHours     Int      @default(24) // antecedência mínima para cancelar/reagendar online
  bookingWindowDays  Int      @default(60)
  cnes               String   @default("") // CNES do estabelecimento (guias TISS)
  // Telemedicina
  videoBaseUrl       String   @default("https://meet.jit.si") // servidor Jitsi (público ou próprio)
  videoEmbed         Boolean  @default(false) // abrir o vídeo dentro do sistema (exige Jitsi próprio ou JaaS)
  teleConsentText    String   @default("")
  // Lembretes automáticos
  remindersEnabled   Boolean  @default(true)
  reminder24h        Boolean  @default(true)
  reminder2h         Boolean  @default(true)
  reminderChannels   String   @default("[\"WHATSAPP\",\"EMAIL\"]") // JSON: WHATSAPP | SMS | EMAIL
  reminderTemplate   String   @default("")
  // Taxas das maquininhas/gateway, em centésimos de % (ex.: 349 = 3,49%) — usadas na conciliação
  feeCreditBp        Int      @default(0)
  feeDebitBp         Int      @default(0)
  feePixBp           Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model Unit {
  id            String         @id @default(cuid())
  name          String
  address       String         @default("")
  active        Boolean        @default(true)
  professionals Professional[]
  availability  Availability[]
  appointments  Appointment[]
}

model Specialty {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  description   String         @default("")
  symptoms      String         @default("") // palavras-chave para a busca por sintoma, separadas por vírgula
  icon          String         @default("stethoscope")
  active        Boolean        @default(true)
  professionals Professional[]
}

model Insurance {
  id            String         @id @default(cuid())
  name          String         @unique
  active        Boolean        @default(true)
  priceCents    Int?           // valor de repasse/tabela padrão (opcional)
  ansCode       String         @default("") // registro ANS da operadora (6 dígitos)
  providerCode  String         @default("") // código do prestador (clínica) na operadora
  tussCode      String         @default("10101012") // procedimento TUSS da consulta
  tableCode     String         @default("22") // tabela TUSS
  tissVersion   String         @default("4.01.00")
  professionals Professional[]
  appointments  Appointment[]
  patients      Patient[]
  tissBatches   TissBatch[]
}

model Professional {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  title         String          @default("Dr(a).")
  crm           String
  crmUf         String          @default("SP")
  photoUrl      String          @default("")
  gallery       String          @default("[]") // JSON: URLs de fotos adicionais
  bio           String          @default("")
  education     String          @default("")
  experience    String          @default("")
  priceCents    Int             @default(0)
  durationMin   Int             @default(30)
  inPerson      Boolean         @default(true)
  telemedicine  Boolean         @default(false)
  published     Boolean         @default(true)
  cbo           String          @default("225125") // CBO-S (guias TISS); 225125 = médico clínico
  payoutPercent Int             @default(70) // % do valor recebido repassado ao profissional
  unitId        String?
  unit          Unit?           @relation(fields: [unitId], references: [id])
  specialties   Specialty[]
  insurances    Insurance[]
  availability  Availability[]
  appointments  Appointment[]
  records       MedicalRecord[]
  messages      Message[]
  payouts       Payout[]
  user          User?
  createdAt     DateTime        @default(now())
}

model Availability {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int          // 0 = domingo ... 6 = sábado
  startTime      String       // "08:00"
  endTime        String       // "12:00"
  unitId         String?
  unit           Unit?        @relation(fields: [unitId], references: [id])
}

model Patient {
  id             String          @id @default(cuid())
  name           String
  cpf            String?         @unique // somente dígitos
  phone          String
  email          String          @default("")
  birthDate      DateTime?
  sex            String          @default("")
  address        String          @default("")
  notes          String          @default("")
  lgpdConsentAt  DateTime?
  remindersOptOut Boolean        @default(false) // paciente pediu para não receber lembretes
  insuranceId    String?         // convênio habitual
  insurance      Insurance?      @relation(fields: [insuranceId], references: [id])
  insuranceCard  String          @default("") // número da carteirinha
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  records        MedicalRecord[]
  payments       Payment[]
  portalSessions PatientSession[]
  loginCodes     PatientLoginCode[]
  requests       PatientRequest[]
}

model Appointment {
  id             String          @id @default(cuid())
  professionalId String
  professional   Professional    @relation(fields: [professionalId], references: [id])
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  unitId         String?
  unit           Unit?           @relation(fields: [unitId], references: [id])
  start          DateTime
  end            DateTime
  type           String          @default("PRESENCIAL") // PRESENCIAL | TELECONSULTA
  status         String          @default("AGENDADA") // AGENDADA | CONFIRMADA | REALIZADA | CANCELADA | FALTOU
  insuranceId    String?
  insurance      Insurance?      @relation(fields: [insuranceId], references: [id])
  priceCents     Int             @default(0)
  source         String          @default("INTERNO") // ONLINE | INTERNO
  notes          String          @default("")
  cancelReason   String          @default("")
  manageToken    String          @unique @default(cuid())
  videoRoom      String?         @unique // sala da teleconsulta (gerada na primeira entrada)
  teleConsentAt  DateTime?       // aceite do termo de teleconsulta pelo paciente
  doctorJoinedAt DateTime?
  patientJoinedAt DateTime?
  reminder24hAt  DateTime?
  reminder2hAt   DateTime?
  confirmedAt    DateTime?
  tissBatchId    String?
  tissBatch      TissBatch?      @relation(fields: [tissBatchId], references: [id])
  tissGuide      String          @default("") // nº da guia do prestador
  authCode       String          @default("") // senha/autorização da operadora (se houver)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  records        MedicalRecord[]
  payments       Payment[]

  @@index([professionalId, start])
  @@index([start])
}

model MedicalRecord {
  id             String             @id @default(cuid())
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  professionalId String
  professional   Professional       @relation(fields: [professionalId], references: [id])
  appointmentId  String?
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id])
  subjective     String             @default("")
  objective      String             @default("")
  assessment     String             @default("")
  plan           String             @default("")
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  prescriptions  PrescriptionItem[]

  @@index([patientId, createdAt])
}

model PrescriptionItem {
  id           String        @id @default(cuid())
  recordId     String
  record       MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  medication   String
  dosage       String        @default("")
  instructions String        @default("")
}

model Payment {
  id             String       @id @default(cuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  description    String       @default("")
  amountCents    Int
  method         String       // PIX | CREDITO | DEBITO | DINHEIRO | BOLETO | CONVENIO | LINK
  installments   Int          @default(1)
  status         String       @default("PENDENTE") // PENDENTE | PAGO | ESTORNADO | CANCELADO
  paidAt         DateTime?
  dueDate        DateTime?
  linkToken      String?      @unique
  gateway        String       @default("manual")
  gatewayRef     String       @default("")
  feeCents       Int          @default(0) // taxa cobrada pela operadora/banco (conciliação)
  reconciledAt   DateTime?
  statementLine  StatementLine?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Message {
  id               String        @id @default(cuid())
  name             String
  email            String        @default("")
  whatsapp         String        @default("")
  preferredChannel String        @default("EMAIL") // EMAIL | WHATSAPP
  body             String
  professionalId   String?
  professional     Professional? @relation(fields: [professionalId], references: [id])
  status           String        @default("NOVA") // NOVA | LIDA | RESPONDIDA | ARQUIVADA
  reply            String        @default("")
  repliedAt        DateTime?
  repliedById      String?
  createdAt        DateTime      @default(now())
}

model Testimonial {
  id         String   @id @default(cuid())
  author     String
  text       String
  rating     Int      @default(5)
  authorized Boolean  @default(false) // só aparece na página com autorização do paciente
  createdAt  DateTime @default(now())
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

// Fila de mensagens (e-mail/SMS/WhatsApp). Sem provedor configurado, o envio é simulado e fica registrado aqui.
model Notification {
  id        String   @id @default(cuid())
  channel   String   // EMAIL | SMS | WHATSAPP
  to        String
  subject   String   @default("")
  body      String
  status    String   @default("SIMULADO") // SIMULADO | ENVIADO | FALHOU
  provider  String   @default("simulado")
  error     String   @default("")
  related   String   @default("")
  createdAt DateTime @default(now())
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String
  passwordHash        String
  role                String          // ADMIN | MEDICO | SECRETARIA | LEITURA
  active              Boolean         @default(true)
  failedAttempts      Int             @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  professionalId      String?         @unique
  professional        Professional?   @relation(fields: [professionalId], references: [id])
  permissionOverrides String          @default("{}") // JSON: { "modulo": ["acao", ...] } para permissões extras/granulares
  createdAt           DateTime        @default(now())
  sessions            Session[]
  resetTokens         PasswordReset[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("")
  action    String   // VIEW | CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAIL | LOGOUT | ...
  entity    String
  entityId  String   @default("")
  details   String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// ---- Fase 2: Área do paciente ----

model PatientLoginCode {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  codeHash  String
  channel   String    // WHATSAPP | SMS | EMAIL
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId, createdAt])
}

model PatientSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// Pedidos do titular (LGPD): correção, exclusão, revogação de consentimento
model PatientRequest {
  id         String    @id @default(cuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind       String    // CORRECAO | EXCLUSAO | REVOGACAO | OUTRO
  details    String    @default("")
  status     String    @default("ABERTO") // ABERTO | CONCLUIDO
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ---- Fase 2: Financeiro completo ----

// Repasse pago ao profissional referente a um mês
model Payout {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  period         String       // "2026-10"
  grossCents     Int          // total recebido das consultas do profissional no mês
  amountCents    Int          // valor repassado
  paidAt         DateTime     @default(now())
  notes          String       @default("")
  createdById    String?

  @@unique([professionalId, period])
}

// Linha de extrato bancário/adquirente importada para conciliação
model StatementLine {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  amountCents Int
  batch       String   // identifica o arquivo importado
  paymentId   String?  @unique
  payment     Payment? @relation(fields: [paymentId], references: [id])
  ignored     Boolean  @default(false) // não é recebimento de paciente (tarifa, transferência etc.)
  importedAt  DateTime @default(now())

  @@unique([date, amountCents, description])
}

// ---- Fase 2: Convênios (TISS) ----

model TissBatch {
  id            String        @id @default(cuid())
  number        Int           // número do lote do prestador
  insuranceId   String
  insurance     Insurance     @relation(fields: [insuranceId], references: [id])
  status        String        @default("GERADO") // GERADO | ENVIADO | PAGO | GLOSADO | CANCELADO
  totalCents    Int
  receivedCents Int?
  glosaCents    Int?
  sentAt        DateTime?
  paidAt        DateTime?
  notes         String        @default("")
  xml           String
  createdById   String?
  createdAt     DateTime      @default(now())
  appointments  Appointment[]

  @@unique([insuranceId, number])
}
